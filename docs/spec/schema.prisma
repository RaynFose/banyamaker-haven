// ManoPhone: схема БД для этапов 1–3 (MySQL / MariaDB на Hostinger Business).
// Описание: 02-data-model.md. Модели внутреннего учёта сервиса (этап 4) — в 02-data-model.md §5.
//
// Соглашения:
// - Поля с пометкой «i18n» — Json вида { "lt": "...", "ru"?: "...", "en"?: "..." } (zod-схема LocalizedText).
// - Деньги хранятся в центах (Int).
// - MySQL не поддерживает массивы, поэтому списки хранятся как Json (string[] / number[]).
// - searchText — нормализованная строка для поиска: нижний регистр, без диакритики, с алиасами.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Справочник устройств ─────────────────────────────

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  WATCH
  OTHER
}

model Brand {
  id        String        @id @default(cuid())
  slug      String        @unique // apple, samsung
  name      String
  logoUrl   String?
  sortOrder Int           @default(0)
  models    DeviceModel[]
}

model DeviceModel {
  id             String     @id @default(cuid())
  slug           String     @unique // iphone-13-pro (= старый /prietaisai/<slug>/)
  name           String // "iPhone 13 Pro"
  brandId        String
  brand          Brand      @relation(fields: [brandId], references: [id])
  type           DeviceType
  series         String? // "iPhone 13", "Galaxy S", "Galaxy A"
  releaseYear    Int?
  imageUrl       String?
  specs          Json? // { screen: "6.1\" OLED", chip: "A15", ... }
  storageOptions Json? // [128, 256, 512, 1024]
  colors         Json? // ["Graphite", "Gold", ...]
  searchText     String     @db.VarChar(500) // "iphone 13 pro ip13pro 13pro apple"
  isPopular      Boolean    @default(false) // плитки «популярные» в калькуляторе
  isActive       Boolean    @default(true)
  repairIntro    Json? // i18n; уникальный текст страницы ремонта модели
  seoTitle       Json? // i18n
  seoDescription Json? // i18n

  repairPrices  RepairPrice[]
  items         InventoryItem[]
  buybackPrices BuybackBasePrice[]
  stockAlerts   StockAlert[]
  leads         Lead[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brandId, type])
}

// ───────────────────────────── Ремонт: прайс ─────────────────────────────

enum PartQuality {
  ORIGINAL // оригинал
  PREMIUM // качественный аналог
  STANDARD // бюджетный аналог
  NONE // работа без детали (ПО, чистка)
}

model RepairType {
  id          String        @id @default(cuid())
  code        String        @unique // screen, battery, charging_port ... (см. migration/repair-prices.json)
  name        Json // i18n
  description Json? // i18n; «Если нет чёрных пятен и полос — достаточно заменить стекло»
  icon        String?
  appliesTo   Json // ["PHONE","TABLET"]
  sortOrder   Int           @default(0)
  prices      RepairPrice[]
}

model RepairPrice {
  id           String      @id @default(cuid())
  modelId      String
  model        DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  repairTypeId String
  repairType   RepairType  @relation(fields: [repairTypeId], references: [id])
  quality      PartQuality @default(NONE)
  priceCents   Int? // null = «Kaina sutartinė»
  isFromPrice  Boolean     @default(false) // «nuo 30 €»
  durationMin  Int? // ориентир: 30
  warrantyDays Int         @default(90)
  isActive     Boolean     @default(true)
  updatedAt    DateTime    @updatedAt

  @@unique([modelId, repairTypeId, quality])
}

// ───────────────────────────── Телефоны на продажу ─────────────────────────────

enum ItemCondition {
  NEW // новый, запечатан
  OPEN_BOX // новый, вскрыт
  REFURBISHED // восстановлен
  USED // б/у
}

enum ItemGrade {
  A_PLUS // как новый
  A // мелкие следы, незаметны с 30 см
  B // заметные потёртости
  C // царапины / сколы, полностью рабочий
}

enum ItemStatus {
  DRAFT // готовится (фото, проверка)
  LISTED // в продаже
  RESERVED // зарезервирован
  SOLD
  ARCHIVED
}

enum VatScheme {
  STANDARD
  MARGIN
  NONE
}

model InventoryItem {
  id             String        @id @default(cuid())
  sku            String        @unique // MP-000142
  slug           String        @unique // iphone-14-pro-256gb-deep-purple-mp000142
  modelId        String
  model          DeviceModel   @relation(fields: [modelId], references: [id])
  storageGb      Int?
  ramGb          Int?
  color          String?
  condition      ItemCondition
  grade          ItemGrade?
  batteryHealth  Int? // %
  imei           String? // только админка
  simUnlocked    Boolean       @default(true)
  accountFree    Boolean       @default(true) // iCloud / Google FRP отвязан
  includes       Json? // ["box","cable","case"]
  replacedParts  Json? // i18n; «Baterija pakeista 2026-10 (originali)»
  description    Json? // i18n
  warrantyMonths Int           @default(6)
  priceCents     Int
  compareAtCents Int? // старая цена
  costCents      Int? // закупка (только админка, для маржи)
  vatScheme      VatScheme     @default(MARGIN)
  status         ItemStatus    @default(DRAFT)
  isFeatured     Boolean       @default(false)
  checklist      Json? // { imei: true, account: true, tests: true, photos: true }
  views          Int           @default(0)
  reservedUntil  DateTime?
  listedAt       DateTime?
  soldAt         DateTime?
  photos         ItemPhoto[]
  leads          Lead[]
  orderLines     OrderLine[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, modelId])
  @@index([status, priceCents])
}

model ItemPhoto {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  key       String // R2 key; варианты _400.webp, _800.webp, _1600.webp
  width     Int
  height    Int
  alt       String?
  sortOrder Int           @default(0)
}

model StockAlert {
  id            String      @id @default(cuid())
  modelId       String
  model         DeviceModel @relation(fields: [modelId], references: [id])
  storageGb     Int?
  maxPriceCents Int?
  email         String
  locale        String      @default("lt")
  notifiedAt    DateTime?
  createdAt     DateTime    @default(now())
}

// ───────────────────────────── Скупка: оценка ─────────────────────────────

model BuybackBasePrice {
  id        String      @id @default(cuid())
  modelId   String
  model     DeviceModel @relation(fields: [modelId], references: [id])
  storageGb Int         @default(0) // 0 = любая память
  maxCents  Int // цена за идеальный аппарат
  updatedAt DateTime    @updatedAt

  @@unique([modelId, storageGb])
}

model BuybackModifier {
  id         String  @id @default(cuid())
  question   String // works | screen | body | battery | biometrics | account | box
  answer     String // ok | scratches | cracked ...
  label      Json // i18n
  percent    Int? // -30
  minusCents Int?
  rejects    Boolean @default(false) // «įvertinsime individualiai»
  sortOrder  Int     @default(0)

  @@unique([question, answer])
}

// ───────────────────────────── Заявки (входящие с сайта) ─────────────────────────────

enum LeadType {
  REPAIR // заявка на ремонт / диагностику из прайса или калькулятора
  MAIL_IN // «отправлю телефон почтой / курьером»
  RESERVATION // бронь телефона в салоне
  QUESTION // «Klausti» по телефону на продажу
  BUYBACK // результат калькулятора скупки
  CONTACT // общая форма
}

enum LeadStatus {
  NEW
  IN_PROGRESS // связались
  DONE // клиент пришёл / сделка
  CANCELLED // отказ / не дозвонились
}

model Lead {
  id          String         @id @default(cuid())
  number      String         @unique // Z-2026-00042
  type        LeadType
  status      LeadStatus     @default(NEW)
  name        String
  phone       String // E.164
  email       String?
  message     String?        @db.Text
  locale      String         @default("lt")
  modelId     String?
  model       DeviceModel?   @relation(fields: [modelId], references: [id])
  modelText   String? // если модели нет в справочнике
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  data        Json? // REPAIR: { repairCodes, estimateCents, preferredTime }; BUYBACK: { storageGb, answers, estimateMin, estimateMax }
  photos      Json? // R2 keys
  source      String? // utm / страница
  staffNote   String?        @db.Text
  handledById String?
  handledBy   User?          @relation(fields: [handledById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, type, createdAt])
}

// ───────────────────────────── Онлайн-заказы (этап 2) ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT // ждём оплату (резерв 30 мин)
  PAID
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  PICKUP
  PARCEL_MACHINE // Omniva / LP Express / DPD
  COURIER
}

model Order {
  id              String         @id @default(cuid())
  number          String         @unique // U-2026-00042
  status          OrderStatus
  name            String
  phone           String
  email           String
  locale          String         @default("lt")
  delivery        DeliveryMethod
  carrier         String?
  pickupPointId   String?
  pickupPointName String?
  shippingAddress Json?
  shippingCents   Int            @default(0)
  subtotalCents   Int
  totalCents      Int
  paymentMethod   String // bank_link | card | bnpl
  paymentRef      String?        @unique // id платежа Montonio
  paidAt          DateTime?
  trackingNo      String?
  invoiceNumber   String?        @unique
  companyDetails  Json? // счёт на фирму
  customerNote    String?        @db.Text
  expiresAt       DateTime?
  lines           OrderLine[]
  events          OrderEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
}

model OrderLine {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id])
  title      String // снимок названия
  priceCents Int
  vatScheme  VatScheme
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  note      String?
  userId    String?
  createdAt DateTime     @default(now())
}

// ───────────────────────────── Контент ─────────────────────────────

model Page {
  id             String   @id @default(cuid())
  path           String   @unique // "/informacija/remonto-laikas/"
  template       String   @default("content") // content | landing | city | legal
  title          Json // i18n
  blocks         Json // [{ type: "hero" | "text" | "faq" | "prices" | "cta" | "steps" | "reviews" | "map", ... }]
  seoTitle       Json? // i18n
  seoDescription Json? // i18n
  localizedPaths Json? // { ru: "/ru/...", en: "/en/..." }
  isPublished    Boolean  @default(false)
  noindex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       Json // i18n
  excerpt     Json? // i18n
  body        Json // блоки
  coverKey    String?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model Faq {
  id        String @id @default(cuid())
  topic     String // general | repair | buyback | shop | warranty
  question  Json // i18n
  answer    Json // i18n
  sortOrder Int    @default(0)
}

model Redirect {
  id        String    @id @default(cuid())
  fromPath  String    @unique @db.VarChar(500)
  toPath    String?   @db.VarChar(500)
  code      Int       @default(301) // 301 | 410
  hits      Int       @default(0)
  lastHitAt DateTime?
}

model NotFoundLog {
  id       String   @id @default(cuid())
  path     String   @unique @db.VarChar(500)
  hits     Int      @default(1)
  lastAt   DateTime @default(now())
  referrer String?  @db.VarChar(500)
}

model ReviewCache {
  id        String   @id @default(cuid())
  source    String   @default("google")
  author    String
  rating    Int
  text      String   @db.Text
  date      DateTime
  isVisible Boolean  @default(true)
}

model Setting {
  key   String @id // company, hours, contacts, facts, languages, shipping
  value Json
}

// ───────────────────────────── Служебное ─────────────────────────────

// Очередь задач вместо фонового воркера: cron hPanel раз в минуту вызывает /api/cron.
model Job {
  id        String    @id @default(cuid())
  type      String // send_email | send_telegram | release_reservation | stock_alert | sync_reviews | backup
  payload   Json
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lastError String?   @db.Text
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}

enum Role {
  OWNER // всё
  MANAGER // каталог, цены, заявки, заказы, контент
  STAFF // заявки, брони, публикация телефонов (без закупочных цен)
  CONTENT // страницы, блог, SEO
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role
  passwordHash String
  totpSecret   String?
  isActive     Boolean   @default(true)
  leads        Lead[]
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // item.price_changed, prices.bulk_update, lead.status ...
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
