// ManoPhone: черновик схемы БД (PostgreSQL). Описание в 02-data-model.md.
// Поля с пометкой // i18n — Json вида { "lt": "...", "ru"?: "...", "en"?: "..." }
// Деньги хранятся в центах (Int), чтобы не было ошибок округления.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Справочник устройств ─────────────────────────────

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  WATCH
  OTHER
}

model Brand {
  id        String        @id @default(cuid())
  slug      String        @unique // apple, samsung
  name      String
  logoUrl   String?
  sortOrder Int           @default(0)
  models    DeviceModel[]
}

model DeviceModel {
  id          String     @id @default(cuid())
  slug        String     @unique // iphone-13-pro (= старый /prietaisai/<slug>/)
  name        String // "iPhone 13 Pro"
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id])
  type        DeviceType
  series      String? // "iPhone 13", "Galaxy S", "Galaxy A"
  releaseYear Int?
  imageUrl    String?
  specs       Json? // { screen: "6.1\" OLED", chip: "A15", ... }
  storageOptionsGb Int[] // [128, 256, 512, 1024]
  colors      String[]
  aliases     String[] // для поиска: "13pro", "ip13 pro"
  isActive    Boolean    @default(true)
  // SEO-текст страницы ремонта модели
  repairIntro Json? // i18n
  seoTitle    Json? // i18n
  seoDescription Json? // i18n

  repairPrices  RepairPrice[]
  items         InventoryItem[]
  buybackPrices BuybackBasePrice[]
  tickets       RepairTicket[]
  buybacks      BuybackRequest[]
  stockAlerts   StockAlert[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brandId, type])
}

// ───────────────────────────── Ремонт: прайс ─────────────────────────────

enum PartQuality {
  ORIGINAL // оригинал / снятый оригинал
  PREMIUM // качественный аналог
  STANDARD // бюджетный аналог
  NONE // работа без детали (ПО, чистка)
}

model RepairType {
  id          String        @id @default(cuid())
  code        String        @unique // screen, battery, charging_port ... (см. migration/repair-prices.json)
  name        Json // i18n
  description Json? // i18n; "Если нет чёрных пятен и полос — достаточно заменить стекло"
  icon        String?
  appliesTo   DeviceType[]
  sortOrder   Int           @default(0)
  prices      RepairPrice[]
}

model RepairPrice {
  id            String      @id @default(cuid())
  modelId       String
  model         DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  repairTypeId  String
  repairType    RepairType  @relation(fields: [repairTypeId], references: [id])
  quality       PartQuality @default(NONE)
  priceCents    Int? // null = «цена по запросу»
  isFromPrice   Boolean     @default(false) // «nuo 30 €»
  durationMin   Int? // ориентир: 30
  warrantyDays  Int         @default(90)
  isActive      Boolean     @default(true)
  updatedAt     DateTime    @updatedAt

  @@unique([modelId, repairTypeId, quality])
}

// ───────────────────────────── Склад / каталог продажи ─────────────────────────────

enum ItemCondition {
  NEW // новый, запечатан
  OPEN_BOX // новый, вскрыт
  REFURBISHED // восстановлен у нас
  USED // б/у
}

enum ItemGrade {
  A_PLUS // как новый, без следов
  A // мелкие следы, незаметны с 30 см
  B // заметные потёртости
  C // сколы/царапины, полностью рабочий
}

enum ItemStatus {
  DRAFT // принят, готовится (фото, проверка)
  LISTED // в продаже
  RESERVED // зарезервирован (заказ / бронь)
  SOLD
  RETURNED // вернули → обратно в DRAFT после проверки
  ARCHIVED // списан / на запчасти
}

enum VatScheme {
  STANDARD // НДС 21% с полной цены
  MARGIN // маржинальная схема (б/у)
  NONE // не плательщик НДС
}

enum ItemSource {
  BUYBACK // куплен у клиента
  SUPPLIER
  TRADE_IN
  OTHER
}

model InventoryItem {
  id            String        @id @default(cuid())
  sku           String        @unique // MP-000142
  slug          String        @unique // iphone-14-pro-128gb-deep-purple-mp000142
  modelId       String
  model         DeviceModel   @relation(fields: [modelId], references: [id])
  storageGb     Int?
  ramGb         Int?
  color         String?
  condition     ItemCondition
  grade         ItemGrade?
  batteryHealth Int? // %
  imei          String? // только админка
  serial        String?
  simLock       Boolean       @default(false)
  icloudFrpFree Boolean       @default(true)
  includes      String[] // ["box","cable","case"]
  replacedParts Json? // i18n; "Baterija pakeista 2026-10 (originali)"
  description   Json? // i18n
  warrantyMonths Int          @default(6)
  priceCents    Int
  compareAtCents Int? // старая цена
  costCents     Int? // закупка (только админка)
  repairCostCents Int        @default(0) // вложено в подготовку
  vatScheme     VatScheme     @default(MARGIN)
  status        ItemStatus    @default(DRAFT)
  source        ItemSource    @default(OTHER)
  buybackId     String?       @unique
  buyback       BuybackRequest? @relation(fields: [buybackId], references: [id])
  location      String? // "vitrina", "sandėlis", "pas meistrą"
  isFeatured    Boolean       @default(false)
  listedAt      DateTime?
  soldAt        DateTime?
  reservedUntil DateTime?
  photos        ItemPhoto[]
  orderLines    OrderLine[]
  events        ItemEvent[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, modelId])
  @@index([status, priceCents])
}

model ItemPhoto {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  key       String // R2 key; варианты: _400.webp, _800.webp, _1600.webp
  width     Int
  height    Int
  alt       String?
  sortOrder Int           @default(0)
}

model ItemEvent {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String // created, listed, price_changed, reserved, released, sold, returned
  data      Json?
  userId    String?
  createdAt DateTime      @default(now())
}

model StockAlert {
  id        String       @id @default(cuid())
  modelId   String
  model     DeviceModel  @relation(fields: [modelId], references: [id])
  storageGb Int?
  maxPriceCents Int?
  email     String?
  phone     String?
  locale    String       @default("lt")
  notifiedAt DateTime?
  createdAt DateTime     @default(now())
}

// ───────────────────────────── Клиенты ─────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique // E.164: +37067306748
  locale    String   @default("lt")
  marketingConsent Boolean @default(false)
  notes     String?
  orders    Order[]
  tickets   RepairTicket[]
  buybacks  BuybackRequest[]
  appointments Appointment[]
  createdAt DateTime @default(now())
}

// ───────────────────────────── Заказы ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT // создан, ждём оплату (резерв 30 мин)
  RESERVED // бронь в салоне без оплаты (24–48 ч)
  PAID
  PROCESSING // готовим к отправке
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED // полностью
  PARTIALLY_REFUNDED
}

enum DeliveryMethod {
  PICKUP
  PARCEL_MACHINE // Omniva / LP Express / DPD
  COURIER
}

enum PaymentMethod {
  BANK_LINK
  CARD
  BNPL // рассрочка / лизинг
  CASH_ON_PICKUP
  CARD_ON_PICKUP
  BANK_TRANSFER
}

model Order {
  id            String         @id @default(cuid())
  number        String         @unique // U-2026-00042
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  status        OrderStatus
  locale        String         @default("lt")
  delivery      DeliveryMethod
  carrier       String? // omniva | lp_express | dpd
  pickupPointId String?
  pickupPointName String?
  shippingAddress Json?
  shippingCents Int            @default(0)
  subtotalCents Int
  discountCents Int            @default(0)
  tradeInCents  Int            @default(0) // зачёт trade-in
  totalCents    Int
  paymentMethod PaymentMethod
  tradeInId     String?        @unique
  tradeIn       BuybackRequest? @relation("OrderTradeIn", fields: [tradeInId], references: [id])
  customerNote  String?
  invoiceNumber String?        @unique
  companyDetails Json? // если счёт на фирму: { name, code, vat, address }
  expiresAt     DateTime? // когда снять резерв
  lines         OrderLine[]
  payments      Payment[]
  shipments     Shipment[]
  events        OrderEvent[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
}

model OrderLine {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id])
  title      String // снимок названия на момент заказа
  priceCents Int
  qty        Int            @default(1)
  vatScheme  VatScheme
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  provider    String // montonio | cash | pos
  providerRef String?  @unique
  amountCents Int
  status      String // pending | paid | failed | refunded
  raw         Json?
  createdAt   DateTime @default(now())
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  carrier     String
  trackingNo  String?
  labelUrl    String?
  status      String // created | sent | delivered | returned
  createdAt   DateTime @default(now())
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  note      String?
  userId    String?
  createdAt DateTime @default(now())
}

// ───────────────────────────── Ремонт: запись и тикеты ─────────────────────────────

model Appointment {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  modelId     String?
  modelText   String? // если модели нет в справочнике
  repairCodes String[]
  startsAt    DateTime
  durationMin Int       @default(30)
  status      String    @default("booked") // booked | confirmed | arrived | no_show | cancelled
  ticketId    String?   @unique
  ticket      RepairTicket? @relation(fields: [ticketId], references: [id])
  note        String?
  createdAt   DateTime  @default(now())

  @@index([startsAt])
}

enum TicketStatus {
  NEW // заявка с сайта / почта, устройство ещё не у нас
  AWAITING_DEVICE // ждём посылку/курьера
  RECEIVED // принят в салоне, акт подписан
  DIAGNOSING
  AWAITING_APPROVAL // клиенту отправлена цена
  APPROVED
  WAITING_PARTS
  IN_REPAIR
  QUALITY_CHECK
  READY // готов к выдаче / отправке
  SHIPPED_BACK
  COMPLETED // выдан, оплачен
  DECLINED // клиент отказался → выдать без ремонта
  CANNOT_REPAIR
}

enum IntakeChannel {
  WALK_IN
  APPOINTMENT
  MAIL_IN // посылка / автобус
  COURIER
}

model RepairTicket {
  id            String        @id @default(cuid())
  number        String        @unique // R-2026-00123
  publicToken   String        @unique // для ссылки статуса без логина
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  modelId       String?
  model         DeviceModel?  @relation(fields: [modelId], references: [id])
  modelText     String?
  imei          String?
  channel       IntakeChannel
  status        TicketStatus  @default(NEW)
  problem       String // со слов клиента
  deviceState   Json? // { screen: "cracked", back: "ok", powersOn: true, faceId: false ... }
  accessories   String[] // ["case","sim tray"]
  unlockCode    String? // шифруется, удаляется после выдачи
  intakePhotos  String[] // R2 keys
  signatureKey  String? // подпись на планшете (PNG)
  estimateCents Int?
  approvedCents Int?
  finalCents    Int?
  approvedAt    DateTime?
  loanerPhone   String? // выданный подменный телефон
  assigneeId    String?
  assignee      User?         @relation(fields: [assigneeId], references: [id])
  dueAt         DateTime?
  warrantyUntil DateTime?
  parentTicketId String? // гарантийный возврат → ссылка на исходный ремонт
  parentTicket  RepairTicket? @relation("WarrantyChain", fields: [parentTicketId], references: [id])
  warrantyTickets RepairTicket[] @relation("WarrantyChain")
  lines         TicketLine[]
  events        TicketEvent[]
  appointment   Appointment?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, dueAt])
}

model TicketLine {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  repairCode  String?
  title       String
  quality     PartQuality  @default(NONE)
  priceCents  Int
  partCostCents Int?
  warrantyDays Int         @default(90)
}

model TicketEvent {
  id        String       @id @default(cuid())
  ticketId  String
  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  from      TicketStatus?
  to        TicketStatus
  publicNote String? // видно клиенту на /statusas
  internalNote String?
  notified  Boolean      @default(false)
  userId    String?
  createdAt DateTime     @default(now())
}

// ───────────────────────────── Скупка / trade-in ─────────────────────────────

model BuybackBasePrice {
  id         String      @id @default(cuid())
  modelId    String
  model      DeviceModel @relation(fields: [modelId], references: [id])
  storageGb  Int?
  maxCents   Int // цена за идеальный аппарат
  updatedAt  DateTime    @updatedAt

  @@unique([modelId, storageGb])
}

model BuybackModifier {
  id        String        @id @default(cuid())
  question  String // screen | body | battery | works | icloud | box
  answer    String // ok | scratches | cracked ...
  label     Json // i18n
  // либо процент от базы, либо фикс. вычет
  percent   Int? // -30
  minusCents Int?
  rejects   Boolean       @default(false) // iCloud заблокирован → не покупаем (или «на запчасти»)
  sortOrder Int           @default(0)

  @@unique([question, answer])
}

enum BuybackStatus {
  NEW // онлайн-оценка
  CONTACTED
  AWAITING_DEVICE // ждём визит / курьера
  INSPECTING
  OFFER_SENT // финальная цена после проверки
  ACCEPTED
  PAID // деньги выплачены, договор подписан
  REJECTED // клиент отказался / не прошёл проверку
  RETURNED // вернули устройство
}

model BuybackRequest {
  id            String        @id @default(cuid())
  number        String        @unique // S-2026-00017
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  modelId       String?
  model         DeviceModel?  @relation(fields: [modelId], references: [id])
  modelText     String?
  storageGb     Int?
  answers       Json // { screen: "ok", body: "scratches", battery: "85", works: "yes", icloud: "off" }
  photos        String[]
  estimateMinCents Int?
  estimateMaxCents Int?
  finalCents    Int?
  status        BuybackStatus @default(NEW)
  isTradeIn     Boolean       @default(false)
  channel       IntakeChannel @default(WALK_IN)
  payoutMethod  String? // cash | bank
  payoutIban    String? // шифруется
  // договор: паспортные данные шифруются (см. 01-architecture §6)
  sellerIdEncrypted String?
  contractPdfKey String?
  paidAt        DateTime?
  item          InventoryItem?
  order         Order?        @relation("OrderTradeIn")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ───────────────────────────── Контент ─────────────────────────────

model Page {
  id        String        @id @default(cuid())
  path      String        @unique // "/informacija/remonto-laikas/" (lt); переводы — в translations
  template  String        @default("content") // content | landing | city | legal
  title     Json // i18n
  blocks    Json // массив блоков: hero, text, faq, prices, cta, steps, reviews, map
  seoTitle  Json? // i18n
  seoDescription Json? // i18n
  localizedPaths Json? // { ru: "/ru/informaciya/...", en: "/en/info/..." }
  isPublished Boolean     @default(false)
  noindex   Boolean       @default(false)
  updatedAt DateTime      @updatedAt
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       Json // i18n
  excerpt     Json? // i18n
  body        Json // блоки / MDX
  coverKey    String?
  publishedAt DateTime?
  updatedAt   DateTime      @updatedAt
}

model Faq {
  id        String        @id @default(cuid())
  topic     String // general | repair | buyback | shop | warranty
  question  Json // i18n
  answer    Json // i18n
  sortOrder Int           @default(0)
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String?
  code      Int      @default(301) // 301 | 410
  hits      Int      @default(0)
  lastHitAt DateTime?
}

model ReviewCache {
  id        String   @id @default(cuid())
  source    String   @default("google")
  author    String
  rating    Int
  text      String
  date      DateTime
  isVisible Boolean  @default(true)
}

model Setting {
  key   String @id // company, hours, phones, languages, booking, buyback, shipping
  value Json
}

// ───────────────────────────── Персонал и журнал ─────────────────────────────

enum Role {
  OWNER // всё
  MANAGER // заказы, каталог, цены, контент
  TECHNICIAN // тикеты (свои + общая очередь), без денег закупки
  SALES // заказы, приём, скупка, выдача
  CONTENT // страницы, блог, SEO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String
  totpSecret   String?
  isActive     Boolean  @default(true)
  tickets      RepairTicket[]
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // item.price_changed, buyback.id_viewed, order.refunded ...
  entity    String
  entityId  String
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  channel   String // email | sms
  to        String
  template  String // order_paid, ticket_ready, appointment_reminder ...
  entityId  String?
  status    String // queued | sent | failed
  error     String?
  createdAt DateTime @default(now())
}
